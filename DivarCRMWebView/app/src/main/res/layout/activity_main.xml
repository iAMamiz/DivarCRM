<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="16dp" android:background="#FAFAFA" android:layout_width="match_parent" android:layout_height="match_parent">
 <TextView android:text="📥 ورود آگهی از دیوار" android:textSize="22sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="12dp"/>
 <EditText android:id="@+id/urlInput" android:hint="لینک آگهی دیوار را وارد کنید" android:inputType="textUri" android:singleLine="true" android:padding="14dp" android:background="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <Button android:id="@+id/importButton" android:text="🔍 دریافت اطلاعات آگهی" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/>
 <TextView android:id="@+id/status" android:text="وضعیت: آماده" android:textSize="14sp" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#FFFFFF">
  <TextView android:id="@+id/result" android:textSize="15sp" android:padding="12dp" android:textIsSelectable="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 </ScrollView>
 <WebView android:id="@+id/web" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp"/>
</LinearLayout>
